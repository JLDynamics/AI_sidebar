# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Which DeepSeek model to use:
#   deepseek-v4-flash = fast + cheapest (good for page summaries)
#   deepseek-v4-pro   = smarter, still cheap
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default model slug when using OpenRouter (any model in their catalog)
OPENROUTER_MODEL=deepseek/deepseek-chat


# ---------------------------------------------------------------------------
# Agent behaviour — how much of Claude Code's power the bridge unleashes
# ---------------------------------------------------------------------------
# Defaults below = FULL abilities: every tool (web, files, shell), permission
# prompts skipped, multi-turn agent loop on. This is what makes a cheap model
# punch above its weight — but it also means ANY request reaching this server
# can run shell commands and edit files. The server listens on localhost only;
# keep the port private and don't expose it.
#
# To lock it down, uncomment and adjust:

# Skip all permission prompts (1 = full autonomous tools; 0 = must allowlist)
# CLAUDE_SKIP_PERMISSIONS=1

# Restrict which tools EXIST (empty = all). e.g. web-only, no files/shell:
# CLAUDE_RESTRICT_TOOLS=WebSearch,WebFetch

# Auto-approve only these tools (used when CLAUDE_SKIP_PERMISSIONS=0):
# CLAUDE_ALLOWED_TOOLS=WebSearch,WebFetch

# Cap agent turns so nothing runs away (blank = Claude Code default):
CLAUDE_MAX_TURNS=20

# Wall-clock limit for one agent run, in seconds (agent runs > single-shot):
CLAUDE_TIMEOUT=600

# Where file/shell tools operate (blank = bridge/workspace/):
# CLAUDE_WORKDIR=

# Extra dirs the agent may read/edit (comma-separated):
# CLAUDE_ADD_DIRS=

# Ignore globally-configured MCP servers, avoids startup hangs (1 = ignore):
# CLAUDE_STRICT_MCP=1
